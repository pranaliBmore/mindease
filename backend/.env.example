APP_NAME=MindEase Backend
# production: use APP_ENV=production, JWT_SECRET_KEY 32+ random chars; readiness GET /health?ready=true
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=mindease

JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

HF_API_TOKEN=
HF_MODEL=google/flan-t5-large
HF_TEXT_EMOTION_MODEL=SamLowe/roberta-base-go_emotions
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
GPT4ALL_MODEL_PATH=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3})(:\d+)?$
RATE_LIMIT_PER_MINUTE=60
