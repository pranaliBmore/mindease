# MindEase backend - production environment.
# Set these as environment variables on your host (Render dashboard). Do NOT commit real values.

APP_ENV=production
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# MongoDB Atlas SRV connection string (Database -> Connect -> Drivers).
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mindease

# 32+ random chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe - losing it makes existing encrypted notes/messages unreadable.
DATA_ENCRYPTION_KEY=

# Groq API key + model (chat AI). Without a key the chat uses local fallback replies.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Email (signup verification codes). Use Brevo's HTTP API in production - most hosts
# (confirmed on Render) block outbound SMTP entirely, so SMTP_HOST won't work here even
# if it works locally. Free key: https://app.brevo.com/settings/keys/api (also verify a
# sender under Senders & IP -> Senders, matching SMTP_FROM_EMAIL).
BREVO_API_KEY=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MindEase
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# EXACT origin of the deployed frontend. Leave CORS_ORIGIN_REGEX blank in production.
CORS_ORIGINS=https://your-site.netlify.app
CORS_ORIGIN_REGEX=

RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
